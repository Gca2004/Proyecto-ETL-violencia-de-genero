# ============================================================
# .gitignore · Proyecto ETL Violencia de Género (ODS 5)
# ============================================================

# --- Credenciales y variables de entorno (NUNCA subir) ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Entornos virtuales ---
venv/
.venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Airflow (se generan al ejecutar Docker Compose) ---
logs/
plugins/
config/airflow.cfg
airflow.db
standalone_admin_password.txt

# --- Great Expectations (contexto efímero, no se versiona) ---
gx/uncommitted/

# --- Caché del EDA (se regenera desde la fuente) ---
data/eda_cache/

# --- Power BI: archivos temporales y de bloqueo ---
~$*.pbix
*.pbix.lock

# --- Sistema operativo y editores ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/